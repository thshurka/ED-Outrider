# ED Outrider configuration — copy to ed_outrider.toml next to ed_outrider.py and edit.
#
# Every key is optional. Precedence, highest first:
#   command-line flags (--journals, --host, --port, --radius, --db)
#   the ED_JOURNALS environment variable (journal folders, separated by ":" on Linux/macOS, ";" on Windows)
#   this file
#   built-in defaults and journal auto-detection
#
# Journal auto-detection looks in the Windows save folder, every Steam library's Proton prefix
# for Elite (app 359320), and, for legacy folders, any mounted Windows drive's Users/*/Saved Games.
# You only need [journals] if that does not find yours. `python3 ed_outrider.py --write-config`
# writes the settings that are in effect right now as a starting point.
#
# Switches take a bare true or false (no quotes: "false" in quotes is text, not off). A value of the wrong
# type is reported when the server starts and the default is used instead (numbers out of range are brought
# into it).

[journals]
# Folders holding Journal.*.log that are read live. Typical locations:
#   Windows:       C:/Users/<you>/Saved Games/Frontier Developments/Elite Dangerous
#   Steam/Proton:  <library>/steamapps/compatdata/359320/pfx/drive_c/users/steamuser/Saved Games/Frontier Developments/Elite Dangerous
# live = ["C:/Users/you/Saved Games/Frontier Developments/Elite Dangerous"]

# Folders of older journals (an old PC, a backup) imported once on the first run and never re-read.
# legacy = ["D:/old-pc/Saved Games/Frontier Developments/Elite Dangerous"]
# legacy = []  turns off the auto-detected legacy folders (a missing key auto-detects; the same goes for live).

[server]
# host = "127.0.0.1"   # "0.0.0.0" makes the page reachable from other devices on your network
                       # (no authentication: it exposes your journals' contents and lets anyone edit bookmarks)
# port = 8025
# allowed_hosts = ["mypc.lan"]   # extra names the page may be opened by. Outrider answers to any IP address,
#                      # but by name only to localhost and the host above (with "0.0.0.0": this machine's own
#                      # name too), so another web site cannot read it through DNS rebinding; list the names a
#                      # phone or tablet uses if those are not enough. A bare name gets the port added.
# radius = 25          # ly: the sphere of nearby systems the page lists (Spansh is asked once per jump; at least 1)
# radius_choices = [20, 25, 30, 40, 50]   # ly: the page's radius dropdown; larger spheres (up to your jump range,
#                                         # say) work but fetch and redraw more — ~1,500 systems at 100 ly in the black
# Relative paths below (db, backup_dir, speech_file) are relative to the folder ed_outrider.py is in (a relative
# --db flag is relative to the current folder). Your own files go in data/ (git-ignored); resources/ holds the
# shipped ones.
# db = "data/ed_outrider.sqlite"   # browser_defaults.json is kept next to it
# backup_dir = "data/backups"   # backups: dated zips of the database, and every live journal copied once into
#                          # data/backups/journals (restore: --legacy data/backups/journals; see the README)
# backup_keep = 7          # dated database zips kept (outrider-<database name>-*.zip; older ones are deleted
#                          # after a new one is written); the journal archive is never pruned
# backup_every_days = 1    # an automatic backup at start when the last one is older than this, and when the game
#                          # quits (its Shutdown event); 0 turns automatic backups off ("back up now" still works)
# speech_file = "resources/speech.json"   # the spoken alerts' lines, per personality (edit it, or point this at
#                          # your own copy; lines banned with the page's 👎 go in data/speech_banned.json, or next
#                          # to a copy of your own)

[defaults]
# What a browser uses until its user changes it in the page's 🔔 alerts & thresholds dialog.
# Page settings (views, layout, thresholds once changed, notification choices) stay in that browser; the dialog
# can export them to a file, import one, or save them on the server as browser_defaults.json (next to the
# database) for new browsers, which then comes before these defaults.
# unsold_warn = 50000000      # amber "worth selling soon": credits of unsold data on board
# unsold_urgent = 250000000   # red "go sell"
# bio_min = 10000000          # a body only counts as unfinished bio if a single body could pay over this
# sounds = true               # target sounds on by default (the browser still needs one click to allow audio)
# body_highlight_level = 500000      # Here: a body's row turns green when its scan + map data pays this much
#                                    # (straight Universal Cartographics value: no first-discovery,
#                                    # first-mapped or efficiency bonus)
# biology_highlight_value = 10000000 # Here: a body's bio turns violet when its species could pay this much
#                                    # (straight Vista Genomics value: no first-footfall x5)
# body_max_value_include_bonus = true # Here: the Max column (and the system's max total) counts first-discovery,
#                                    # first-mapped and first-footfall bonuses; false shows plain payouts.
#                                    # Now always includes them: it is what a sale would actually pay.
# high_gravity = 2.0              # g (0.1 or more): dropping into orbital cruise at a landable body this heavy or more warns
#                                    # you when the data aboard is over the amber level or the rebuy multiple
# module_warn = 80              # %: core module health (FSD, power plant, thrusters, life support, sensors, fuel
#                                    # scoop, AFMU) shows next to hull, in the welcome back and the co-pilot's status
#                                    # report when one is under this (1 to 100), as of its last Loadout or repair
# surface_alt = 1000             # m: the surface map on Now shows below this altitude and hides above it plus
#                                    # 100 m (in the SRV or on foot it always shows)
# rig_spacing = 50               # m: the faint ring round a Rhino mining rig: how close the game lets two rigs be
#                                    # (two were placed ~44-51 m apart in a test; the game draws a 50 m ring); 0 draws no ring
# surface_map_min = 500          # m: the surface map zooms to fit you and its markers, never tighter than this across
# surface_map_strip = false      # also a small copy of the surface map in the on-body strip
# rig_warn = 3500                # m: say so when a mining rig is this far from your Rhino (again at 4,500 m); the
#                                    # game destroys a rig 5,000 m from its Rhino
# voice = "en_GB-southern_english_female-low"   # spoken alerts (🗣 in the page): the Piper voice, downloaded
#                                               # into data/piper-voices/ on first use; needs `pip install piper-tts`
#                                               # (see outrider/tts.py), otherwise the browser's own speech is used;
#                                               # a voice picked in the page's alerts dialog wins over this
# voice_fallback = "en_GB-jenny_dioco-medium"   # used while the voice above is missing
# speech_styles = ["business"]   # spoken alerts' personalities, picked from at random: any of the styles in
#                                # speech.json ("business", "sarcastic", "sweet", or one you add); a single
#                                # style may also be written as a plain string, speech_styles = "sarcastic"
# speech_profanity = false       # also use the swearing versions (sarcastic and sweet have them)
# speech_profanity_pct = 50      # with profanity on: how often (%) a line comes from the swearing versions
# speech_danger_business = true # danger lines (hull, heat, interdiction, fuel low or unscoopable, your
#                                # carrier leaving without you, the ship-loss debrief) come only from the business lists, never swearing
# speak_bio_signals = true        # say "2 Biological Signals on body A 3" as the FSS finds them
# speak_geo_signals = true        # and the geological ones
# speak_mapped = false            # after mapping a planet: "A 2 mapped efficiently, 3.4M. Next: biology on
#                                 # C 2, up to 19M." (a card and a spoken line; also a tick in the alerts dialog)
# speech_speed = 1.0              # spoken alerts' pace: 1 is the voice's own, 1.3 is 30% faster (0.5 to 2)
# speech_names = "Boss, Hefay, Sir"   # what the voice calls you, comma separated; one is picked at random
#                                    # each time (commander names are often unpronounceable)

[autohonk]
# Hold Primary Fire on arriving in a system by hyperspace, so the Discovery Scanner fires (Linux; outrider/honk.py).
# IMPORTANT: the Discovery Scanner MUST be on PRIMARY FIRE in the fire group that is active when you jump.
# Primary Fire needs a keyboard binding in Elite's controls (as its second binding, keeping your trigger first).
# enabled = false        # the page's 🔔 alerts dialog switches it on and off too (and remembers)
# key = "auto"           # "auto": Primary Fire's keyboard binding from your controls preset (modifiers too;
#                        # the Ship line of a preset per mode; a built-in preset has no file to read, so bind it
#                        # in a custom one); or a combination such as KEY_KP0 or KEY_LEFTALT+KEY_K
# delay = 2.0            # seconds after arriving before the press (the jump tunnel ignores input)
# hold = 6.0             # seconds to hold the trigger (the scanner fires once charged)
# skip_honked = true     # leave systems you have already honked alone
# announce = true        # when it completes, say "System Scan Completed, 12 Bodies discovered" (or "...all
#                        # bodies were found" when the honk found everything); the dialog can switch it per browser

[spansh]
# concurrency = 4       # body-detail fetches in flight after an arrival (be kind to Spansh; at least 1)
# map_max_radius = 250  # ly: the largest 3D map the page may ask for (Spansh caps a search at 10,000 systems)
# map_max_pages = 6     # pages of 500 systems fetched for the map; near the bubble each page is several MB
# watch_firsts = true   # the firsts watch: in the background, look up your unsold first discoveries on Spansh,
#                       # most valuable first (one request every 10-30 s at most; each system daily for a month
#                       # after your scan, then weekly, and weekly once seen; at most 150 a day), and mark the ones someone else has scanned since you (My firsts, the Unsold tile).
#                       # Your own EDDN uploads (EDMC and the like) are told apart by their time. false: never asks

[speech]
# For the page's "Play speech and sounds on this PC" tick (in the 🔔 alerts dialog, per browser, off until
# ticked): the PC running Outrider then plays the spoken lines and the alert sounds itself (Linux only).
# server_player = "auto"   # "auto" (the first of pw-play, paplay, aplay and ffplay installed), one of those
#                          # by name, or "off" (the tick then falls back to the browser playing them)

[copilot]
# One HOTAS (or keyboard) button for the voice (Linux; outrider/button.py). Tap: a status report (fuel and jumps, the
# next stop, what is aboard against your rebuy, the nearest unvisited system; a targeted body first; the sampling
# while you sample). Double tap: the last line again. Hold: hush the voice until the next jump (danger still
# speaks); hold again to end it. In the Rhino on a planet any press marks a mining rig placed or picked up instead.
# Outrider only reads the button, never grabs it: unbind it in Elite's controls, or it does its game action too.
# On an X-56, avoid the latching toggles and the mode wheel: they report as buttons held down.
# Joysticks and throttles are readable through uaccess; a keyboard or mouse needs the input group.
# python3 -m outrider.button --listen  lists the devices and prints the name of each button you press.
# enabled = false
# device = "X-56 Rhino Throttle"   # a part of the device's name, or a /dev/input/by-id/... path
# button = "BTN_TRIGGER_HAPPY5"    # the button's evdev name, or its code number, as --listen prints it
# hold_ms = 600                    # held this long (ms) or more: a hold
# double_ms = 350                  # a second press within this long (ms) of the first release: a double tap

[highway]
# The Neutron Highway: a route plotted with Spansh (neutron stars as boosts) that Outrider follows as you fly.
# clipboard = true          # on arriving at a route system, copy the next system's name to the desktop clipboard
#                           # (wl-copy under Wayland, xclip under X11; Linux), ready to paste into the galaxy map
# autotarget = false        # after an FSD supercharge in a route system, target the next system. Not built yet:
#                           # it only logs "would target ..." and presses nothing
# autotarget_delay = 5      # seconds after the supercharge (0 to 60)
# efficiency = 60           # the neutron plotter's efficiency (%, 1 to 100): lower goes further out of its way
#                           # for neutron stars
# The Highway map draws the galactic regions; it can also show a top-down galaxy image of your own under them.
# Outrider ships none: point this at one you downloaded (PNG, JPEG, WebP or GIF; a path relative to this folder, or
# absolute). Only that file is served to the page.
# background_image = ""
# background_extent = [-45000, 45000, -20000, 70000]   # ly: the image's edges, [xmin, xmax, zmin, zmax]. The default
#                           # is the bounds the usual galaxy images (EDAstro's charts) use: X -45000 to 45000, Z -20000 to 70000
# background_opacity = 0.6  # 0.05 to 1
